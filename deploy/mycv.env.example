# Copied to /etc/mycv/mycv.env by deploy/install.sh (only if missing). Edit there, then:
#   sudo systemctl restart mycv-server
MYCV_LISTEN=127.0.0.1:7801
MYCV_DB=/var/lib/mycv/mycv.db
# OAuth 2.0 "Web application" client ID from https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origin must be https://mycv.coffeesos.online
MYCV_GOOGLE_CLIENT_ID=
# Anthropic API key (https://platform.claude.com/) - enables "Upload CV, AI fills the form".
# Leave empty to hide the feature.
ANTHROPIC_API_KEY=
